# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (MongoDB Atlas) ---
# Full connection string from your Atlas cluster, e.g.:
# mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# --- App ---
# Absolute base URL used to build links in emails (verification, invite, password reset).
APP_URL=http://localhost:3000

# --- Sessions / Auth ---
# Long random secret used as an HMAC key when hashing session/verification/invite tokens for
# storage (defense-in-depth on top of the tokens' own randomness). Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# --- File storage (Cloudinary) ---
# Either set CLOUDINARY_URL as a single value...
CLOUDINARY_URL=
# ...or set these three individually instead:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) — used for sending documents/notifications, not for scheduled reminders ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Optional: SMS provider for 2FA (leave blank to disable SMS 2FA) ---
SMS_PROVIDER=
SMS_API_KEY=

# --- PDF generation (lib/pdf/*) ---
# No env var and no setup needed — @react-pdf/renderer is pure JS (no headless browser/Chromium
# binary), so it works out of the box in any deploy environment, including Vercel serverless
# functions.
